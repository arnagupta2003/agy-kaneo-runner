# --- Kaneo Connection (on qubit) ---
KANEO_URL=https://kaneo.your-domain.com
KANEO_API_KEY=replace_with_agy_bot_api_key
KANEO_PROJECT_ID=replace_with_project_id

# --- Kaneo Column Slugs (must match your Kaneo board slugs) ---
COL_INVESTIGATE=investigate
COL_INVESTIGATING=investigating
COL_READY_FOR_APPROVAL=ready-for-approval
COL_APPROVED=approved
COL_IN_PROGRESS=in-progress
COL_IN_REVIEW=in-review
COL_BLOCKED=blocked

# --- Antigravity CLI (agy) ---
# Option A (recommended for headless): provide GEMINI_API_KEY
GEMINI_API_KEY=
# Option B: leave GEMINI_API_KEY empty and run `docker compose exec -it agy-kaneo-runner agy` once to OAuth login
AGY_MODEL=
AGY_EFFORT=medium
AGY_INVESTIGATE_TIMEOUT=10m
AGY_EXECUTE_TIMEOUT=20m

# --- Dagu Web UI Basic Auth ---
DAGU_AUTH_BASIC_USERNAME=admin
DAGU_AUTH_BASIC_PASSWORD=change-me-strong-password

# --- Production / TARS (docker-compose.prod.yml) ---
IMAGE_NAME=youruser/agy-kaneo-runner:latest
DAGU_BIND_IP=127.0.0.1
